# ==============================================================================
# GEZT Smart Filing AI Configuration
# ==============================================================================
# The Smart Filing feature connects to either OpenRouter or Gemini API.
# Add your API key below and restart Vite (`npm run dev`) to activate Live AI mode.

# Option 1: Google Gemini Direct API (Recommended & fast)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 2: OpenRouter API
# Get an API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
